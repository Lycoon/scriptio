// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id                  Int         @id @default(autoincrement())
  createdAt           DateTime    @default(now())
  email               String      @unique
  verified            Boolean     @default(false)

  projects            ProjectMember[]

  secrets             Secret      @relation(fields: [secretsId], references: [id])
  secretsId           Int         @unique

  settings            Settings    @relation(fields: [settingsId], references: [id])
  settingsId          Int         @unique
}

model Secret {
  id                  Int         @id @default(autoincrement())
  user                User?

  hash                String
  salt                String

  emailHash           String
  lastEmailHash       DateTime    @default(now())
  recoverHash         String?
  lastRecoverHash     DateTime    @default(now())
}

model Settings {
  id                  Int         @id @default(autoincrement())
  user                User?

  highlightOnHover    Boolean     @default(false)
  sceneBackground     Boolean     @default(true)
  notesColor          String      @default("#FFFF68")
  exportedNotesColor  String      @default("#FFFF68")
  onlineUsername      String?
  onlineColor         String?
}

model Project {
  id                  String      @id @default(uuid())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  title               String
  description         String?
  poster              Boolean     @default(false)
  characters          Json?

  members             ProjectMember[]
  invitations         ProjectInvitation[]
}

model ProjectMember {
  id                  Int         @id @default(autoincrement())
  role                ProjectRole @default(VIEWER)

  user                User        @relation(fields: [userId], references: [id])
  userId              Int
  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId           String

  @@unique([userId, projectId])
}

model ProjectInvitation {
  id                   Int        @id @default(autoincrement())
  token                String     @unique
  email                String
  createdAt            DateTime   @default(now())

  project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId            String
  
  @@unique([email, projectId])
}