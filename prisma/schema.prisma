// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id                  String      @id @default(uuid())
  createdAt           DateTime    @default(now())
  email               String      @unique
  verified            Boolean     @default(false)

  settings            Settings?
  secrets             Secret?

  projects            ProjectMember[]
}

model Secret {
  id                  Int         @id @default(autoincrement())

  userId              String      @unique
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  password            String
  emailHash           String?
  recoverHash         String?
  lastEmailHash       DateTime    @default(now())
  lastRecoverHash     DateTime    @default(now())
}

model Settings {
  id                  Int         @id @default(autoincrement())

  userId              String      @unique 
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  highlightOnHover    Boolean     @default(false)
  sceneBackground     Boolean     @default(true)
  notesColor          String      @default("#FFFF68")
  exportedNotesColor  String      @default("#FFFF68")
  onlineUsername      String?
  onlineColor         String?
}

model Project {
  id                  String      @id @default(uuid())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  title               String
  description         String?
  hasPoster           Boolean     @default(false)
  characters          Json?

  members             ProjectMember[]
  invitations         ProjectInvitation[]
}

model ProjectMember {
  id                  Int         @id @default(autoincrement())
  role                ProjectRole @default(VIEWER)

  user                User        @relation(fields: [userId], references: [id])
  userId              String
  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId           String

  @@unique([userId, projectId])
}

model ProjectInvitation {
  id                   Int        @id @default(autoincrement())
  token                String     @unique
  email                String
  createdAt            DateTime   @default(now())

  project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId            String
  
  @@unique([email, projectId])
}